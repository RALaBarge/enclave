#!/bin/sh
# sbx-channel: the sandbox box's only SSH entry point for the core.
#
# Installed by image/provision-sbx.sh and forced in the broker key's authorized_keys line:
#   command="/opt/sbx/sbx-channel",no-port-forwarding,...,restrict
#
# No remote command is the tool channel: exec sbx-run unchanged, so the broker sees the same
# program and exit codes it always has. The single other verb, "reset", runs the root helper
# through sudo; it is how the core triggers a per-job reboot. One dispatcher because sshd takes
# the options from the first matching authorized_keys line and never considers later ones, so one
# key cannot carry two forced commands; a second key or account would be a second convention.
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  "")    exec /opt/sbx/sbx-run ;;
  reset) exec /usr/bin/sudo -n /usr/local/sbin/sbx-reset ;;
  *)     echo "sbx-channel: unknown request" >&2; exit 64 ;;
esac
