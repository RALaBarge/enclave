#!/usr/bin/env python3
"""fetch: an HTTP GET made by Ryan's browser, through browserbox's gate on win11.

stdin  {"url": "https://..."}
stdout {"url", "body"}      body is the response text, cut at 200,000 characters

The extension makes the request with Ryan's cookies for that site, so it is signed in as him. That is
the hole this tool exists for: it reaches one host and port, which the core's allowlist opens for this and nothing
else. /deskbox/tool/gate holds "URL TOKEN" and is written at deploy, not kept in git.
"""
import json
import sys
import urllib.request

with open("/deskbox/tool/gate", encoding="ascii") as f:
    gate, token = f.read().split()
req = urllib.request.Request(gate + "/fetch", data=sys.stdin.buffer.read(),
                             headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
with urllib.request.urlopen(req, timeout=30) as r:
    json.dump(json.load(r), sys.stdout)
