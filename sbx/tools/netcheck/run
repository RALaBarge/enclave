#!/usr/bin/env python3
"""netcheck: the sandbox box's network, checked from where a tool stands.

The network half of sbx-node-test, run as a tool (tools.list gives it `net`): if this job cannot get out, no tool can.
The root-only half (nftables ruleset, forced-command key, nothing of the core installed) stays in sbx-node-test at the
box's keyboard; a tool cannot see /opt or /home and should not be able to.

stdin  {"expect": "blocked" | "open", "host": "example.com"}   both optional; expect says what the core's allowlist
       should currently do with HTTPS to host (a fresh setup allows nothing)
stdout {"passed": n, "failed": n, "checks": [{"name", "ok", "detail"}]}
"""
import json
import re
import socket
import ssl
import sys

CORE, ME = "10.77.0.1", "10.77.0.2"
req = json.load(sys.stdin)
expect, host = req.get("expect", "blocked"), req.get("host", "example.com")
if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", host):
    sys.exit("host must be a hostname")
checks = []


def check(name, ok, detail):
    checks.append({"name": name, "ok": bool(ok), "detail": detail})


def hexip4(h):
    return socket.inet_ntoa(bytes.fromhex(h)[::-1])


def reach(addr, port, timeout, tls_name=None):
    """None if a TCP connection (and the TLS handshake, given a name) completes, else the error."""
    try:
        with socket.create_connection((addr, port), timeout=timeout) as s:
            if tls_name:
                ssl.create_default_context().wrap_socket(s, server_hostname=tls_name).close()
        return None
    except (OSError, ssl.SSLError) as e:
        return type(e).__name__


# Addressing: one IPv4 address, the core as gateway and resolver.
addrs = set()
for line in open("/proc/net/fib_trie"):
    if "/32 host LOCAL" in line:
        addrs.add(prev.split()[-1])
    prev = line
addrs.discard("127.0.0.1")
check("address", addrs == {ME}, "local addresses: %s" % (" ".join(sorted(addrs)) or "none"))
gws = [hexip4(f[2]) for f in (l.split() for l in open("/proc/net/route").readlines()[1:]) if f[1] == "00000000"]
check("gateway", gws == [CORE], "default via: %s" % (" ".join(gws) or "none"))
try:
    ns = [l.split()[1] for l in open("/etc/resolv.conf") if l.split()[:1] == ["nameserver"]]
except OSError:
    ns = []
check("resolver", ns == [CORE], "nameservers: %s" % (" ".join(ns) or "none"))

# Listeners: only sshd on the link (or loopback).
bad = []
for f, v6 in (("/proc/net/tcp", False), ("/proc/net/tcp6", True)):
    try:
        rows = open(f).readlines()[1:]
    except OSError:
        continue
    for r in rows:
        local, state = r.split()[1], r.split()[3]
        if state != "0A":
            continue
        a, port = local.split(":")
        ip = socket.inet_ntop(socket.AF_INET6, b"".join(bytes.fromhex(a[i:i + 8])[::-1] for i in range(0, 32, 8))) if v6 else hexip4(a)
        if not (ip.startswith("127.") or ip in ("::1", ME)):
            bad.append("%s:%d" % (ip, int(port, 16)))
check("listeners", not bad, "unexpected: " + " ".join(bad) if bad else "all on %s or loopback" % ME)

# The core exposes nothing to this box.
for port in (8787, 22):
    err = reach(CORE, port, 3)
    check("core:%d" % port, err, "not reachable (%s)" % err if err else "reachable: the core must not expose this to the box")

# Egress through the core's allowlist.
err = reach(host, 443, 8, tls_name=host)
if expect == "open":
    check("egress:" + host, not err, "reachable through the core" if not err else "blocked (%s) but should be open" % err)
else:
    check("egress:" + host, err, "blocked (%s), as expected" % err if err else "reachable but should be blocked")
# Straight to an address, no DNS: only an allowlisted address may pass, so this must be blocked in both modes.
err = reach("9.9.9.9", 443, 5)
check("egress:9.9.9.9", err, "blocked (%s)" % err if err else "reachable: the allowlist is too wide")

n = sum(c["ok"] for c in checks)
json.dump({"passed": n, "failed": len(checks) - n, "checks": checks}, sys.stdout)
