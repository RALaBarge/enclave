#!/usr/bin/env python3
"""glob: workspace paths matching a pattern ("**/*.py", "src/*.c"), newest first.

stdin  {"pattern": str, "path"?: str}
stdout {"files", "truncated"} or {"error"}          at most 500 paths
"""
import glob
import json
import os
import sys

W, CAP = "/deskbox/work", 500
req = json.load(sys.stdin)
base = os.path.realpath(os.path.join(W, req.get("path") or "."))
if base != W and not base.startswith(W + "/") or not os.path.isdir(base) or os.path.isabs(req["pattern"]):
    json.dump({"error": "path must be a directory under %s, pattern relative to it" % W}, sys.stdout)
    sys.exit()
hits = [p for p in glob.glob(os.path.join(base, req["pattern"]), recursive=True) if os.path.isfile(p)]
hits.sort(key=lambda p: os.path.getmtime(p), reverse=True)
json.dump({"files": hits[:CAP], "truncated": len(hits) > CAP}, sys.stdout)
