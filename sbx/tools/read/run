#!/usr/bin/env python3
"""read: lines of a text file in the workspace, numbered like cat -n.

stdin  {"file_path": str, "offset"?: int (1-based), "limit"?: int (default 2000)}
stdout {"content", "total_lines"} or {"error"}            lines longer than 2000 characters are cut, content at 250,000
"""
import json
import os
import sys

W = "/deskbox/work"
req = json.load(sys.stdin)
path = os.path.realpath(os.path.join(W, req["file_path"]))
if not path.startswith(W + "/"):
    err = "file_path must be under %s" % W
elif not os.path.isfile(path):
    err = "no such file: %s" % path
else:
    err = None
if err:
    json.dump({"error": err}, sys.stdout)
    sys.exit()
with open(path, "rb") as f:
    data = f.read(64 << 20)
if b"\0" in data[:8192]:
    json.dump({"error": "binary file: %s" % path}, sys.stdout)
    sys.exit()
lines = data.decode("utf-8", "replace").splitlines()
start = max(req.get("offset", 1), 1)
end = start - 1 + min(max(req.get("limit", 2000), 1), 2000)
out = ["%6d\t%s" % (n, ln[:2000]) for n, ln in enumerate(lines[start - 1:end], start)]
content = "\n".join(out)
if len(content) > 250000:
    content = content[:250000] + "\n[cut at 250,000 characters: read on with a larger offset]"
json.dump({"content": content, "total_lines": len(lines)}, sys.stdout)
