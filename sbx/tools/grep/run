#!/usr/bin/env python3
"""grep: search workspace files for a regular expression (Python re), skipping .git and binary files.

stdin  {"pattern": str, "path"?: str, "include"?: str (one glob on the file name, e.g. "*.py"), "ignore_case"?: bool}
stdout {"matches": ["path:line:text"], "truncated"} or {"error"}      at most 500 matches, text cut at 500 characters
"""
import fnmatch
import json
import os
import re
import sys

W, CAP = "/deskbox/work", 500
req = json.load(sys.stdin)
base = os.path.realpath(os.path.join(W, req.get("path") or "."))
try:
    rx = re.compile(req["pattern"], re.I if req.get("ignore_case") else 0)
except re.error as e:
    rx, err = None, "bad pattern: %s" % e
if base != W and not base.startswith(W + "/") or not os.path.exists(base):
    rx, err = None, "path must be under %s" % W
if rx is None:
    json.dump({"error": err}, sys.stdout)
    sys.exit()


def files():
    if os.path.isfile(base):
        yield base
        return
    for d, dirs, names in os.walk(base):
        dirs[:] = sorted(x for x in dirs if x != ".git")
        for n in sorted(names):
            if not req.get("include") or fnmatch.fnmatch(n, req["include"]):
                yield os.path.join(d, n)


matches = []
for path in files():
    try:
        with open(path, "rb") as f:
            data = f.read(16 << 20)
    except OSError:
        continue
    if b"\0" in data[:8192]:
        continue
    for n, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
        if rx.search(line):
            matches.append("%s:%d:%s" % (path, n, line[:500]))
            if len(matches) > CAP:
                break
    if len(matches) > CAP:
        break
json.dump({"matches": matches[:CAP], "truncated": len(matches) > CAP}, sys.stdout)
