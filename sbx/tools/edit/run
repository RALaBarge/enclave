#!/usr/bin/env python3
"""edit: replace literal text in a workspace file.

stdin  {"file_path": str, "old_string": str, "new_string": str, "replace_all"?: bool}
stdout {"path", "replacements"} or {"error"}       without replace_all, old_string must occur exactly once
"""
import json
import os
import sys

W = "/deskbox/work"
req = json.load(sys.stdin)
path = os.path.realpath(os.path.join(W, req["file_path"]))
old, new = req["old_string"], req["new_string"]


def fail(msg):
    json.dump({"error": msg}, sys.stdout)
    sys.exit()


if not path.startswith(W + "/") or not os.path.isfile(path):
    fail("no such file under %s: %s" % (W, path))
if old == new:
    fail("old_string and new_string are the same")
with open(path, encoding="utf-8", newline="") as f:
    text = f.read()
n = text.count(old) if old else 0
if n == 0:
    fail("old_string not found in %s" % path)
if n > 1 and not req.get("replace_all"):
    fail("old_string occurs %d times in %s; give more context or set replace_all" % (n, path))
with open(path, "w", encoding="utf-8", newline="") as f:
    f.write(text.replace(old, new))
json.dump({"path": path, "replacements": n}, sys.stdout)
