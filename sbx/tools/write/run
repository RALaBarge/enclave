#!/usr/bin/env python3
"""write: create or replace a UTF-8 text file in the workspace (parent directories are made).

stdin  {"file_path": str, "content": str}
stdout {"path", "bytes"} or {"error"}
"""
import json
import os
import sys

W = "/deskbox/work"
req = json.load(sys.stdin)
path = os.path.realpath(os.path.join(W, req["file_path"]))
if not path.startswith(W + "/") or os.path.isdir(path):
    json.dump({"error": "file_path must be a file under %s" % W}, sys.stdout)
    sys.exit()
os.makedirs(os.path.dirname(path), exist_ok=True)
data = req["content"].encode()
with open(path, "wb") as f:
    f.write(data)
json.dump({"path": path, "bytes": len(data)}, sys.stdout)
