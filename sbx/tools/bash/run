#!/usr/bin/env python3
"""bash: run a command in the box's workspace.

stdin  {"command": str, "timeout_ms"?: int, "workdir"?: str}
stdout {"stdout", "stderr", "exit_code", "timed_out"}   each stream cut at 30,000 characters

The workspace (/deskbox/work) is the box's disk and persists between jobs; nothing else is writable. No network:
tools.list never gives `net` to a tool that runs code it is handed. A timeout kills the command's process group.
"""
import json
import os
import signal
import subprocess
import sys
import tempfile

W, CAP = "/deskbox/work", 30000
req = json.load(sys.stdin)
cwd = os.path.realpath(os.path.join(W, req.get("workdir") or "."))
if cwd != W and not cwd.startswith(W + "/") or not os.path.isdir(cwd):
    json.dump({"error": "workdir must be a directory under %s" % W}, sys.stdout)
    sys.exit()
timeout = min(max(req.get("timeout_ms", 100000), 1000), 100000) / 1000   # tools.list allows the job 120 s
with tempfile.TemporaryFile() as out_f, tempfile.TemporaryFile() as err_f:
    # Files, not pipes: a command that prints without end must not make the tool
    # buffer it in memory. sbx-run's RLIMIT_FSIZE caps each file at 64 MiB.
    p = subprocess.Popen(["bash", "-c", req["command"]], cwd=cwd, stdin=subprocess.DEVNULL,
                         stdout=out_f, stderr=err_f, start_new_session=True)
    try:
        p.wait(timeout=timeout)
        timed_out = False
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.wait()
        timed_out = True

    def cut(f):
        size = os.fstat(f.fileno()).st_size
        f.seek(0)
        s = f.read(CAP).decode("utf-8", "replace")
        return s if size <= CAP else s + "\n[cut: %d more characters]" % (size - CAP)

    out, err = cut(out_f), cut(err_f)

json.dump({"stdout": out, "stderr": err, "exit_code": p.returncode, "timed_out": timed_out}, sys.stdout)
