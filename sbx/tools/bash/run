#!/usr/bin/env python3
"""bash: run a command in the box's workspace.

stdin  {"command": str, "timeout_ms"?: int, "workdir"?: str}
stdout {"stdout", "stderr", "exit_code", "timed_out"}   each stream cut at 30,000 characters

The workspace (/deskbox/work) is the box's disk and persists between jobs; nothing else is writable. No network:
tools.list never gives `net` to a tool that runs code it is handed. A timeout kills the command's process group.
"""
import json
import os
import signal
import subprocess
import sys

W, CAP = "/deskbox/work", 30000
req = json.load(sys.stdin)
cwd = os.path.realpath(os.path.join(W, req.get("workdir") or "."))
if cwd != W and not cwd.startswith(W + "/") or not os.path.isdir(cwd):
    json.dump({"error": "workdir must be a directory under %s" % W}, sys.stdout)
    sys.exit()
timeout = min(max(req.get("timeout_ms", 100000), 1000), 100000) / 1000   # tools.list allows the job 120 s
p = subprocess.Popen(["bash", "-c", req["command"]], cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                     stderr=subprocess.PIPE, start_new_session=True)
try:
    out, err = p.communicate(timeout=timeout)
    timed_out = False
except subprocess.TimeoutExpired:
    os.killpg(p.pid, signal.SIGKILL)
    out, err = p.communicate()
    timed_out = True


def cut(b):
    s = b.decode("utf-8", "replace")
    return s if len(s) <= CAP else s[:CAP] + "\n[cut: %d more characters]" % (len(s) - CAP)


json.dump({"stdout": cut(out), "stderr": cut(err), "exit_code": p.returncode, "timed_out": timed_out}, sys.stdout)
