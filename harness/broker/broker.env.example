SBX_HOST=10.77.0.2
SBX_USER=sbx
SBX_KEY=/etc/sbx/id_ed25519
SBX_KNOWN_HOSTS=/etc/sbx/known_hosts
# Where the desk finds the broker. The *-sbx stubs have no network; each job
# gets this one socket bound in at /deskbox/broker.sock by its contract, and
# only the sbxdesk group (the desk's account) may connect to it.
SBX_SOCKET=/run/sbx/broker.sock
SBX_SOCKET_MODE=0660
SBX_SOCKET_GROUP=sbxdesk
# TCP stays off unless you set SBX_LISTEN. Turning it on means anything that
# can reach the address can submit jobs to the sandbox; the unix socket is
# there so that is not necessary.
# SBX_LISTEN=127.0.0.1
# Run after every job; the broker's one-job lock is held until it returns, so it must not return
# early. Examples:
#   lite (sandbox in this VM):   empty -- every job gets a fresh bwrap tmpfs, and a reboot would
#                                take the broker with it
#   full (separate box):         SBX_RESET_CMD=/usr/local/bin/sbx-reboot-and-wait
#   full (QEMU VM, disk revert): not shipped -- sbx-vm-revert is a host-side QEMU operation, so the
#                                core cannot run it (see image/SETUP.md, Full mode)
SBX_RESET_CMD=
# One sandbox lane. A caller that arrives while a job is running waits in
# arrival order, but only while fewer than SBX_QUEUE_MAX callers are already
# waiting and only for SBX_QUEUE_WAIT_S seconds; past either bound the broker
# answers 503 lane_busy instead of blocking. 0 means no waiting at that bound.
# GET /status on the same socket reports busy, queued, depth_max, the last
# job and the last reset. A failed reset gates the next job with 503
# sandbox_not_reset (and a retry of the reset) until one succeeds.
# Raise both to tolerate more overlapping harnesses; lower them to fail
# fast. Keep the total under the stub's client timeout.
SBX_QUEUE_MAX=4
SBX_QUEUE_WAIT_S=60
