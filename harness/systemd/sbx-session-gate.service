[Unit]
Description=sbx-session-gate (the one place a new session's firewall profile is forced)
After=network.target sbx-console.service
Wants=sbx-console.service

[Service]
User=sbxgate
# Its own group, not the bridge's. Two groups, two permissions: `sbxgate` reads
# the tighten-only token (root:sbxgate 0640) and owns the socket, and the
# bridge is a member of `sbxgate` so it can connect. The gate is deliberately
# not in `pibridge`, so it cannot read /run/sbx/secrets.env - the process that
# may force a firewall profile has no business holding model keys.
Group=sbxgate
SupplementaryGroups=
RuntimeDirectory=sbx-gate
RuntimeDirectoryMode=0755
Environment=SBX_GATE_SOCKET=/run/sbx-gate/gate.sock
Environment=SBX_GATE_CONSOLE=http://127.0.0.1:8787
Environment=SBX_GATE_TOKEN_FILE=/etc/sbxfw/tighten-token
ExecStart=/usr/bin/python3 /opt/sbx-gate/session_gate.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/etc/sbxfw
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
