[Unit]
Description=DeskBox agent desk (contract-enforced tool calls for the core's harnesses)
Documentation=file:///opt/deskbox/README.md
After=network.target sbx-broker.service
Wants=sbx-broker.service

[Service]
User=deskbox
Group=deskbox
# The only group that may connect to sbx-broker's socket, and the socket is
# the only way tool calls leave this box. Membership is not a convenience:
# /run/sbx is 0750 sbxbroker:sbxdesk, so without this the desk cannot stat the
# socket the job sandbox needs to bind.
SupplementaryGroups=sbxdesk
WorkingDirectory=/var/lib/deskbox
# Per-job resource limits go through `systemd-run --user --scope`, which needs
# this account's own session bus. The wrapper resolves the uid and waits for
# it: a `%U` here would be the manager's UID (0) in a system unit, not
# deskbox's, which is a restart loop. `loginctl enable-linger deskbox`
# (provisioning) is what makes the bus exist without a login.
ExecStart=/usr/local/bin/deskbox-run
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/deskbox
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
