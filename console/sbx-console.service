[Unit]
Description=sbx-console (firewall, tools and settings panel for the deskbox sandbox bridge)
After=nftables.service
Wants=nftables.service

[Service]
User=sbxconsole
Group=sbxconsole
SupplementaryGroups=systemd-journal
Environment=SBX_COMMON=/opt/sbx-console/common
ExecStart=/usr/bin/python3 /opt/sbx-console/sbx_console.py
Restart=on-failure
# nft needs CAP_NET_ADMIN and netlink; nothing else.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/etc/sbxfw /etc/sbx
ReadOnlyPaths=/opt/sbx/tools /opt/deskbox/tools

[Install]
WantedBy=multi-user.target
