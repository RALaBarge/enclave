# Everything the VM image contains, pinned. provision.sh refuses to run with any REQUIRED value empty
# (set ALLOW_UNPINNED=1 only for local experiments). Fill hashes/commits once, commit this file.

# --- Base: Debian 13 (trixie). Python 3.13 and bubblewrap come from here.
DEBIAN_ISO_URL=https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_SHA256=a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355

# --- Ollama (embeddings for Loom, baked in so the VM needs no network after build)
OLLAMA_VERSION=0.40.4
OLLAMA_TGZ_SHA256=15f31e9576d15a481e099b4145dba6e9f8c1f295927d6b8895300ae30ed3740a   # sha256 of ollama-linux-amd64.tar.zst for that version
EMBED_MODEL=nomic-embed-text  # pulled once at build time into /var/lib/ollama/models

# --- Loom (Python, FastAPI + SQLite/sqlite-vec). Port 9741, loopback only.
LOOM_REPO=https://github.com/ralabarge/loom
LOOM_COMMIT=fccf0e1f694b0d378125bbcd516b64b8ad820cf3   # full 40-char commit sha

# --- DeskBox (Go, CGO_ENABLED=0). Built on the build host with `make dist`; binaries dropped in
#     image/artifacts/deskbox-linux-amd64 (and tcs-shim). Record the commit it was built from.
DESKBOX_REPO=https://github.com/ralabarge/deskbox
# 4a39e50 = branch `sandbox-bind`: sandbox.bind, so the *-sbx stubs reach the
# broker over a bound unix socket instead of being given the host netns.
# Push that branch before building from a clean clone; BUILD-DESKBOX.md covers
# building from a local clone until then.
DESKBOX_COMMIT=4a39e508dccccf39ecd54f0db4b7c9bc356026d2

# --- Node.js (build toolchain for Pi only; unpacked to /opt/node-build, not on system PATH). Pi needs >= 22.19.
NODE_VERSION=22.23.3
NODE_SHA256=1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af

# --- Pi (lightweight harness). Built from source at a pinned commit inside the image build.
PI_REPO=https://github.com/earendil-works/pi
PI_VERSION=1.2.0
PI_SOURCE_SHA256=ccfa08c4ae2ab4f744bcc7b5fe0ad47960b6d3dffde65e480bce215b83624dbd   # pi-1.2.0-source.tar.gz (release commit 06a466935536f8c9bcacb2d5efc0fc021be1bdff)
PI_BIN=out/linux-x64/pi                              # relative to the checkout

# --- Bun (Pi's build-binaries.sh runs `bun build --compile`; build-time only)
BUN_VERSION=1.4.3
BUN_SHA256=1fc2edac843102909e3a1be1d8d9802cc6071cf074e67e88231f4ffe0f8b397b   # bun-linux-x64-baseline.zip (runs on CPUs without AVX2; also the runtime embedded into pi)

# --- Bitwarden Secrets Manager CLI (core only; fetches LLM keys at service start, see image/sbx-fetch-secrets.sh)
BWS_VERSION=2.1.0
BWS_SHA256=ba8233c3a4aee5d43e3c73bbd04d99e9bc5aba13bbbfd06d89b073abe732b860   # bws-x86_64-unknown-linux-gnu-2.1.0.zip

# --- Tailscale (node agent for tailnet peer messaging; the bridge still starts without --peers, so peers stay off
#     until the operator logs in and opts in. No auth key is in the image: `tailscale up` is the operator's step.)
TS_VERSION=1.104.1
TS_TGZ_SHA256=108d1d96ecf410d305571e173516f27038f870919a9b89c914a167c6d33a4528   # tailscale_1.104.1_amd64.tgz; from https://pkgs.tailscale.com/stable/tailscale_1.104.1_amd64.tgz.sha256
